{
  "name": "echdyn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted document extraction with local LLMs.",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "prepare": "husky",
    "lint": "prettier --check . && eslint .",
    "format": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "pnpm --filter @echdyn/core db:generate",
    "db:migrate": "pnpm --filter @echdyn/core db:migrate",
    "db:fresh": "pnpm --filter @echdyn/core db:fresh && pnpm db:seed",
    "db:seed": "pnpm --filter @echdyn/core db:seed",
    "eval:generate": "pnpm --filter @echdyn/core eval:generate",
    "eval": "pnpm --filter @echdyn/core eval"
  },
  "devDependencies": {
    "@echdyn/core": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
