{
  "name": "echdyn",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted document extraction with local LLMs.",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
