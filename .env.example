# Host ports (override locally if a default is already in use)
APP_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=9000
S3_CONSOLE_PORT=9001
OLLAMA_PORT=11434

# Postgres
POSTGRES_USER=echdyn
POSTGRES_PASSWORD=echdyn
POSTGRES_DB=echdyn

# S3-compatible storage (RustFS locally, AWS S3 in production)
S3_BUCKET=echdyn-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=echdyn
S3_SECRET_KEY=echdyn-secret
# Host the browser uses for signed download URLs (match S3_PORT if you change it)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Ollama (point at another machine, e.g. http://homeserver:11434, to use its GPU)
OLLAMA_HOST=http://ollama:11434
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# How long one model call may take (ms); vision on CPU is slow on its first call
OLLAMA_TIMEOUT_MS=1800000
# Models Ollama keeps in memory at once; 1 unless the machine can hold text and vision together
OLLAMA_MAX_LOADED_MODELS=1

# Approve documents with no flagged fields without human review
AUTO_APPROVE=true

# Single admin for the UI and API. The defaults only suit localhost: change all four
# before the app is reachable from anywhere else (generate secrets with openssl rand -hex 32)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-locally
# Bearer token for the REST API, at least 32 characters
API_TOKEN=local-dev-api-token-change-me-0000
# Signs session cookies, at least 32 characters; changing it signs everyone out
SESSION_SECRET=local-dev-session-secret-change-me-00
