@baseUrl = http://localhost:8000
# API_TOKEN from .env
@apiToken = local-dev-api-token-change-me-0000

### Health

# Liveness check used by the Docker healthcheck
GET {{baseUrl}}/api/health

### Auth

# No token or session: returns 401 with error code "unauthenticated"
POST {{baseUrl}}/api/documents

###

# The UI redirects to /login when there is no session (follow redirects off to see the 307)
# @no-redirect
GET {{baseUrl}}/

### Documents

# Dry run before uploading: same fields as an upload, nothing stored or queued. Returns page
# kinds (text, scan, blank), which model reads it, an estimate from recent runs, any duplicate
# and the queue. This mixed fixture is a typed cover letter in front of a scanned bill
POST {{baseUrl}}/api/documents/inspect
Authorization: Bearer {{apiToken}}
Content-Type: multipart/form-data; boundary=echdyn

--echdyn
Content-Disposition: form-data; name="document_type"

uk-energy-bill
--echdyn
Content-Disposition: form-data; name="file"; filename="mixed-energy-bill.pdf"
Content-Type: application/pdf

< ./fixtures/mixed-energy-bill.pdf
--echdyn--

###

# Upload a PDF for extraction: returns 201 with the new document id and status "queued"
POST {{baseUrl}}/api/documents
Authorization: Bearer {{apiToken}}
Content-Type: multipart/form-data; boundary=echdyn

--echdyn
Content-Disposition: form-data; name="document_type"

uk-energy-bill
--echdyn
Content-Disposition: form-data; name="file"; filename="sample-energy-bill.pdf"
Content-Type: application/pdf

< ./fixtures/sample-energy-bill.pdf
--echdyn--

###

# Upload the same file again: returns 200 with the original document id and "duplicate": true
POST {{baseUrl}}/api/documents
Authorization: Bearer {{apiToken}}
Content-Type: multipart/form-data; boundary=echdyn

--echdyn
Content-Disposition: form-data; name="document_type"

uk-energy-bill
--echdyn
Content-Disposition: form-data; name="file"; filename="sample-energy-bill-copy.pdf"
Content-Type: application/pdf

< ./fixtures/sample-energy-bill.pdf
--echdyn--

###

# Unknown document type: returns 422 with error code "unknown_document_type"
POST {{baseUrl}}/api/documents
Authorization: Bearer {{apiToken}}
Content-Type: multipart/form-data; boundary=echdyn

--echdyn
Content-Disposition: form-data; name="document_type"

invoice
--echdyn
Content-Disposition: form-data; name="file"; filename="sample-energy-bill.pdf"
Content-Type: application/pdf

< ./fixtures/sample-energy-bill.pdf
--echdyn--

###

# Non-PDF content: returns 415 with error code "not_pdf"
POST {{baseUrl}}/api/documents
Authorization: Bearer {{apiToken}}
Content-Type: multipart/form-data; boundary=echdyn

--echdyn
Content-Disposition: form-data; name="document_type"

uk-energy-bill
--echdyn
Content-Disposition: form-data; name="file"; filename="notes.txt"
Content-Type: text/plain

these are not the bills you are looking for
--echdyn--

###

# Progress for one document: status, current stage, queue position and a time estimate.
# Replace the id with one returned by an upload above
GET {{baseUrl}}/api/documents/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{apiToken}}


###

# Documents, newest first, with the list page's filters: status, type, q (file name), page, page_size
GET {{baseUrl}}/api/documents?status=needs_review&page_size=10
Authorization: Bearer {{apiToken}}

###

# A filter the API does not know: returns 422 with error code "invalid_query" saying what is allowed
GET {{baseUrl}}/api/documents?status=done
Authorization: Bearer {{apiToken}}

### Records

# Approved records, newest first, with paging (page, page_size up to 100)
GET {{baseUrl}}/api/records
Authorization: Bearer {{apiToken}}

###

# Search the file name and every value in the records (not field names), case-insensitively
GET {{baseUrl}}/api/records?q=northern
Authorization: Bearer {{apiToken}}

###

# Unit rate above 30p: field filters are field:operator:value, checked against the type's schema,
# so they need a type. Numbers and dates take eq, ne, gt, gte, lt, lte; text takes eq, ne, contains
GET {{baseUrl}}/api/records?type=uk-energy-bill&filter=unit_rate_pence:gt:30
Authorization: Bearer {{apiToken}}

###

# Several filters combine: a supplier, billing periods from 2026, approved in October (inclusive)
GET {{baseUrl}}/api/records?type=uk-energy-bill&filter=supplier:contains:severn&filter=billing_period_start:gte:2026-01-01&approved_from=2026-10-01&approved_to=2026-10-31
Authorization: Bearer {{apiToken}}

###

# A filter that does not fit the field: returns 422 explaining why (text cannot be compared with gt)
GET {{baseUrl}}/api/records?type=uk-energy-bill&filter=supplier:gt:a
Authorization: Bearer {{apiToken}}

###

# One record with the extraction it came from and every correction a reviewer made: the audit trail.
# Replace the id with one from the list above
GET {{baseUrl}}/api/records/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{apiToken}}

### Export

# Approved records as CSV (the default format): field keys as headers, one row per record.
# Needs a type, as the columns come from its schema; takes the same filters as GET /api/records
GET {{baseUrl}}/api/records/export?type=uk-energy-bill
Authorization: Bearer {{apiToken}}

###

# The same as an Excel workbook: readable headers, real numbers and dates, £ formatting.
# An X-Echdyn-Truncated: true header means more records matched than one export holds (50,000)
GET {{baseUrl}}/api/records/export?type=uk-energy-bill&format=xlsx&filter=unit_rate_pence:gt:30
Authorization: Bearer {{apiToken}}

###

### Webhooks

# Add an endpoint: approvals are POSTed to it as "record.approved" events. The response carries
# the signing secret, the only time it is shown
POST {{baseUrl}}/api/webhooks
Authorization: Bearer {{apiToken}}
Content-Type: application/json

{
  "url": "https://example.com/echdyn-hook",
  "description": "Accounts system"
}

###

# Every endpoint with its delivery counts (pending, delivered, failed); secrets are never listed
GET {{baseUrl}}/api/webhooks
Authorization: Bearer {{apiToken}}

###

# Send a signed "ping" event to check a receiver and its secret. Replace the id with one from above
POST {{baseUrl}}/api/webhooks/00000000-0000-0000-0000-000000000000/ping
Authorization: Bearer {{apiToken}}

###

# The latest 50 deliveries to an endpoint: status, attempts, last HTTP status and error
GET {{baseUrl}}/api/webhooks/00000000-0000-0000-0000-000000000000/deliveries
Authorization: Bearer {{apiToken}}

###

# Stop deliveries to an endpoint (204); its delivery log is kept
DELETE {{baseUrl}}/api/webhooks/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{apiToken}}
